{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft": "Warning", "System.Net.Http.HttpClient": "Warning" } },
  "Sites": {
    "RegistryPath": "config/sites/sites.json"
  },
  "Aggregation": {
    "NewsroomTimeZone": "Asia/Ho_Chi_Minh",
    "BotInfoPath": "/bot",
    "SensitiveTopicsPath": "config/aggregation/sensitive-topics.json",
    "Worker": {
      "Parallelism": 8,
      "PollSeconds": 30,
      "LeaseSeconds": 120,
      "MaintenanceMinutes": 5
    },
    "Clustering": {
      "Similarity": 0.5,
      "SimilarityWithEntity": 0.25,
      "WindowHours": 48
    },
    "Scoring": {
      "Sources": 35,
      "Trust": 15,
      "Relevance": 15,
      "Velocity": 15,
      "Freshness": 20
    },
    "Classification": {
      "AutoAssign": 0.80,
      "Review": 0.50
    }
  }
}
