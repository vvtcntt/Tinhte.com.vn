{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": { "IncludeScopes": true }
  },
  "AllowedHosts": "*",
  "Sites": {
    "Environment": "production",
    "RegistryPath": "config/sites/sites.json"
  },
  "ForwardedHeaders": {
    "TrustForwardedHost": false,
    "KnownProxies": []
  }
}
