{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": { "IncludeScopes": true }
  },
  "AllowedHosts": "*",
  "Sites": {
    "Environment": "production",
    "RegistryPath": "config/sites/sites.json"
  },
  "Ai": {
    "Provider": {
      "Key": "yescale",
      "BaseUrl": "https://api.yescale.io/v1/",
      "Model": "gpt-5.4-mini"
    },
    "MaxInputChars": 12000,
    "QuotaPerHour": 60
  },
  "ForwardedHeaders": {
    "TrustForwardedHost": false,
    "KnownProxies": []
  }
}
